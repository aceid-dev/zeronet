# Build and publish
IMAGE_NAME=ghcr.io/aceid-dev/zeronet
IMAGE_TAG=latest
DOCKER_PLATFORMS=linux/amd64,linux/arm64
ALPINE_VERSION=3.20
PIP_VERSION=24.2
SETUPTOOLS_VERSION=75.0.0
OCI_SOURCE=https://github.com/aceid-dev/zeronet
ZERONET_REPO_URL=https://github.com/ZeroNetX/ZeroNet.git
ZERONET_REPO_REF=6dc1ebd93ff488dd5d8fe42242fa435a199a7833

# Compose runtime
ZERONET_NETWORK_SUBNET=10.0.6.0/24
ZERONET_CONTAINER_IP=10.0.6.10
ZERONET_UI_PUBLISH_IP=127.0.0.1
ENABLE_TOR=1
ZERONET_DATA_DIR=/data
ZERONET_CONFIG_FILE=/data/zeronet.conf
ZERONET_FILESERVER_PORT=26552
ZERONET_UI_HOSTS="zeronet zeronet:43110 localhost localhost:43110 127.0.0.1 127.0.0.1:43110 10.0.6.10 10.0.6.10:43110"
ZERONET_UI_EXTRA_HOSTS=
ZERONET_UI_IP=10.0.6.10
ZERONET_UI_PORT=43110
ZERONET_EXTRA_ARGS="--i2p disable"
